#!/bin/sh
# Installs the shared owner as a systemd user service:
#   spqr-daemon install
# Writes $XDG_CONFIG_HOME/systemd/user/spqr-bridge.service (never overwrites) with this repo's
# paths. Registry, tokens and socket live in $SPQR_CONFIG_DIR (default ~/.config/spqr); the
# bridge config is $SPQR_BRIDGE_CONFIG (default config/bridge.local.toml). See docs/CLIENTS.md.
set -eu
[ "${1:-}" = install ] && [ "$#" -eq 1 ] || { echo "spqr-daemon: usage: spqr-daemon install" >&2; exit 2; }
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
dir="${SPQR_CONFIG_DIR:-${HOME:?set SPQR_CONFIG_DIR}/.config/spqr}"
cfg="${SPQR_BRIDGE_CONFIG:-$repo/config/bridge.local.toml}"
units="${XDG_CONFIG_HOME:-${HOME:?}/.config}/systemd/user"
unit="$units/spqr-bridge.service"
case "$repo$dir$cfg" in *'"'*|*'\'*|*'%'*|*'$'*) echo "spqr-daemon: paths must not contain \", \\, % or \$" >&2; exit 2 ;; esac
{ [ -e "$unit" ] || [ -L "$unit" ]; } && { echo "spqr-daemon: $unit exists; remove it first to reinstall" >&2; exit 2; }
mkdir -p "$units"
mkdir -p -m 700 "$dir"
cat > "$unit" <<UNIT
# Generated by scripts/spqr-daemon. The shared SPQR bridge owner (local Unix socket only).
[Unit]
Description=SPQR shared agent bridge (local IPC)

[Service]
Type=exec
WorkingDirectory=$repo
ExecStart="$repo/.venv/bin/python" -m spqr_bridge.daemon --config "$cfg" --registry "$dir/registry.toml" --socket "$dir/bridge.sock" --service-unit spqr-bridge.service
UMask=0077
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
# Exit 2 is a refused start (config, identity, held lock): retrying cannot fix it.
RestartPreventExitStatus=2
NoNewPrivileges=yes

[Install]
WantedBy=default.target
UNIT
echo "Wrote $unit"
echo "Start it:  systemctl --user daemon-reload && systemctl --user enable --now spqr-bridge"
echo "Check it:  systemctl --user status spqr-bridge"
