# Template, not an installed service. Replace absolute paths before use.
# Keep registry, tokens, socket directory and daemon state outside worker roots.
[Unit]
Description=SPQR authenticated shared agent bridge (local IPC)

[Service]
Type=exec
WorkingDirectory=/ABSOLUTE/PATH/TO/SPQR
ExecStart=/ABSOLUTE/PATH/TO/SPQR/.venv/bin/python -m spqr_bridge.daemon --config /ABSOLUTE/PRIVATE/bridge.toml --registry /ABSOLUTE/PRIVATE/registry.toml --socket /ABSOLUTE/PRIVATE/bridge.sock --service-unit spqr-bridge.service
UMask=0077
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=15
# Prefer scripts/spqr-daemon install, which fills in these paths.
# A crash leaves the socket behind; the next start removes it only under the state lock.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2
NoNewPrivileges=yes

[Install]
WantedBy=default.target
